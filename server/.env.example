# SkillBridge Backend Environment Configuration

# Server Port (default 4000)
PORT=4000

# Client Frontend URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Node Environment
NODE_ENV=development

# -------------------------------------------------------------
# Firebase Admin SDK Configuration
# -------------------------------------------------------------
# Option A: Path to serviceAccountKey.json (Recommended for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: Inline Environment Variables (Recommended for production/Render)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
